{
  "name": "finora",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Finora — personal finance tracker built with HTML, CSS, vanilla JavaScript, and Supabase.",
  "scripts": {
    "predev": "node scripts/ensure-config.mjs",
    "dev": "python3 -m http.server 4173",
    "build:vendor": "node scripts/ensure-config.mjs && npm run build:vendor:supabase && npm run build:vendor:capacitor",
    "build:vendor:supabase": "esbuild assets/js/supabase.js --bundle --format=esm --outfile=assets/vendor/supabase.bundle.js --define:process.env.NODE_ENV='\"production\"' --platform=browser",
    "build:vendor:capacitor": "esbuild assets/js/native-bridge.js --bundle --format=esm --outfile=assets/vendor/capacitor.bundle.js --define:process.env.NODE_ENV='\"production\"' --platform=browser",
    "build:www": "node scripts/build-www.mjs",
    "build": "npm run build:vendor && npm run build:www",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:build": "npx cap build android",
    "pretest": "node scripts/ensure-config.mjs",
    "test": "npm run test:sql && npm run test:offline && npm run test:utils && npm run test:structure",
    "test:sql": "node tests/sql.test.mjs",
    "test:offline": "node --test tests/offline.test.mjs",
    "test:utils": "node --test tests/utils.test.mjs",
    "test:structure": "node tests/structure.test.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@electric-sql/pglite": "^0.5.15",
    "@supabase/supabase-js": "^2.119.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/plus-jakarta-sans": "^5.3.0"
  }
}
