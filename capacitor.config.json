{
  "appId": "com.finora.app",
  "appName": "Finora",
  "webDir": "www",
  "plugins": {
    "@capacitor/status-bar": {
      "enabled": true
    },
    "@capacitor/splash-screen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "backgroundColor": "#F8F7FC",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  },
  "android": {
    "allowMixedContent": true
  }
}
